# Velora X — server-side provider configuration
# Never expose these values in client-side code.

# Built-in OpenAI-compatible providers
NARA_API_KEY=
NARA_BASE_URL=https://router.bynara.id/v1
NARA_MODEL=auto

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b

TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Optional custom built-in gateway
CUSTOM_NAME=Custom Gateway
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Add unlimited custom providers/models here.
# This is the recommended way to add more providers without changing code.
# One JSON object = one provider.
# Example:
# PROVIDERS_JSON=[{"id":"my-ai","name":"My AI","key":"sk-...","baseUrl":"https://example.com/v1","model":"my-model","website":"https://example.com"}]
PROVIDERS_JSON=

# Optional detailed error display
EXPOSE_PROVIDER_ERRORS=false
